PROVEEDOR=google            # google | groq | openrouter

GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Verificar el nombre vigente del modelo en la página del proveedor antes de usarlo
MODELO_GOOGLE=
MODELO_GROQ=
MODELO_OPENROUTER=

# Notas de voz (D12): Whisper en Groq. Verificar el nombre vigente en la lista de modelos de Groq
PROVEEDOR_TRANSCRIPCION=groq
MODELO_TRANSCRIPCION=

MAX_ITER=5
TIMEOUT_S=20
PRESUPUESTO_TOKENS=8000

# Solo para pruebas: vacío | 429 | timeout | invalida
FORZAR_ERROR=
# Plan B ante un 429 persistente (necesita su llave y su modelo configurados)
PROVEEDOR_RESPALDO=groq

DATABASE_URL=postgresql://lecreo:lecreo@localhost:5433/lecreo

# Reportes de números (R3): cuentan personas distintas y vencen a los N días
REPORTES_VIGENCIA_DIAS=90
# Opcional. Clave para firmar permisos y anonimizar a quien reporta. Si queda vacía,
# se crea sola en el archivo .secreto (no se sube). Si se usa, que sea larga y aleatoria.
LECREO_SECRETO=

# Bot de Telegram: créalo con @BotFather (/newbot) y pega aquí el token
TELEGRAM_BOT_TOKEN=
